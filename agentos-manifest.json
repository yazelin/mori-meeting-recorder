{
  "schema_version": 2,
  "id": "mori.meeting-recorder",
  "name": "Mori Meeting Recorder",
  "kind": "body-part",
  "version": "0.1.6",
  "realm_mode": "personal",
  "capabilities": ["audio.capture"],
  "permissions": [
    { "class": "audio.capture" }
  ],
  "data_policy": { "owns_raw_data": true, "default_ingestion": "off" },
  "consumes": [
    {
      "skill": "transcribe.local",
      "purpose": "會議逐字稿轉錄(standalone-first:本機 whisper 為主,偵測到共享服務才用)",
      "optional": true
    }
  ],
  "provides": [
    {
      "skill": "meeting.summarize",
      "kind": "http-service",
      "exportable": true,
      "http_service": {
        "descriptor_path": "~/.mori/mori-recorder-server.json",
        "mode": "json"
      },
      "description": "為指定的會議 session 產生雙摘要(公開版 + 內部版),寫進該 session 目錄並回 metadata。",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "會議 session id,例如 meeting-20260604-103215(~/.mori/meetings/ 下的目錄名)"
          },
          "force_local": {
            "type": "boolean",
            "description": "選填;true = 跳過雲端 Groq、只用本機 Ollama 摘要(資料主權逃生口)"
          }
        },
        "required": ["session_id"]
      }
    }
  ]
}
